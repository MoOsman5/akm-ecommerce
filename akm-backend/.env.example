# Server
PORT=5000
NODE_ENV=development

# MongoDB (local or Atlas connection string)
MONGODB_URI=mongodb://localhost:27017/akm-ecommerce

# JWT — use long random strings in production
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# Extra allowed frontend origins, comma-separated
# (http://localhost:3000 and the production Vercel URL are allowed by default)
CORS_ORIGIN=

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
